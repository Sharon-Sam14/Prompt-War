# ── GenAI provider (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_) ──
# Without a key the app still works: /api/plan returns the deterministic fallback plan.
OPENAI_API_KEY=
# Optional overrides (defaults shown)
OPENAI_MODEL=gpt-4o-mini

